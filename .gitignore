# ROS 2 build outputs
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Package-local colcon output (created when colcon is run from the package
# directory instead of the workspace root).
ros2_ws/src/px4_vio_bridge/build/
ros2_ws/src/px4_vio_bridge/install/
ros2_ws/src/px4_vio_bridge/log/

# Stray colcon workspace at the PROJECT ROOT. Running `colcon build` from here
# instead of inside ros2_ws creates a second install space that shadows the real
# one, with launch files copied rather than symlinked -- so they silently stop
# tracking source edits. This cost a debugging session on 2026-07-26; see
# HANDOFF.md. Always build from inside ros2_ws.
/build/
/install/
/log/

# Flight logs: rosbags (.mcap + metadata.yaml), PX4 ULogs, and .launchinfo run
# markers. ~51 MB and growing by a few MB per flight. The .mcap/.ulg extensions
# are matched below, but metadata.yaml and .launchinfo are not, so ignore the
# whole tree.
ros2_ws/flight_logs/
/flight_logs/

# Local runtime output
/reports/
*.tlog
*.tlog.raw
*.ulg
*.bag
*.db3
*.mcap
*.params
# Except the full PX4 parameter backups from scripts/dump_params.py: they are the
# only record of the FC config before each tuning change, and ~35 KB each.
!params_backup_*.params
# MAVProxy drops mav.parm into its working directory automatically. Nothing in
# this project reads it; the real backups are params_backup_*.params from
# scripts/dump_params.py (different format). It was committed by accident in the
# initial import and only escaped the *.params rule by one letter.
*.parm
ros2_ws/vslam_trajectory.txt
.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv*/
venv/
env/

# Large local dependency checkouts/builds
tools/

# DepthAI downloaded model cache
.depthai_cached_models/

# Editor/OS noise
.vscode/
.idea/
.DS_Store
*~

# Generated analysis artifacts under reports/. scripts/analyze_*.py and
# scripts/render_flight_map.py rebuild all of these from the bags and ULogs in
# ros2_ws/flight_logs/, so they are outputs, not sources. The CSVs are the bulk
# of it (a single control-response dump is 1.3 MB). The figures the reports
# actually link to ARE tracked -- ignoring those would break the images in the
# committed markdown -- so this deliberately does not match *.png at the
# reports/ root. Per-flight map renders live in their own maps_<time>/ dirs and
# nothing links to them.
reports/*.csv
reports/*.json
reports/maps_*/
# Console/tool captures kept for reference while debugging (param readbacks,
# live topic dumps, logger topic lists). Same argument as the CSVs: they are
# transcripts of a command, not sources, and nothing links to them.
reports/*.txt
# Additional local migration artifacts (already tracked files remain tracked).
*.json
*.csv
*.png
