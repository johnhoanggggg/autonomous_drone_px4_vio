diff --git a/rtabmap_odom/include/rtabmap_odom/ImmutableCameraInfo.h b/rtabmap_odom/include/rtabmap_odom/ImmutableCameraInfo.h
new file mode 100644
index 0000000..ebfd008
--- /dev/null
+++ b/rtabmap_odom/include/rtabmap_odom/ImmutableCameraInfo.h
@@ -0,0 +1,81 @@
+#pragma once
+
+#include <sensor_msgs/msg/camera_info.hpp>
+#include <sensor_msgs/msg/image.hpp>
+#include <cmath>
+#include <cstdint>
+#include <mutex>
+#include <string>
+
+namespace rtabmap_odom {
+// Experimental fixed-calibration contract. A late calibration change cannot
+// be detected retroactively. Any observed change latches closed until restart.
+class ImmutableCameraInfo {
+public:
+  using Info = sensor_msgs::msg::CameraInfo;
+  using Image = sensor_msgs::msg::Image;
+  bool observe(const Info & info) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!fault_.empty()) return false;
+    if (!valid(info)) return fail("invalid calibration");
+    Info identity = info;
+    identity.header.stamp = builtin_interfaces::msg::Time();
+    if (ready_ && identity != identity_) return fail("calibration changed; restart required");
+    if (!ready_) {
+      identity_ = identity;
+      info_ = info;
+      firstStamp_ = stamp(info.header.stamp);
+      ready_ = true;
+    }
+    return true;
+  }
+  Info::ConstSharedPtr forPair(const Image & image, const Image & depth) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!ready_ || !fault_.empty()) return {};
+    if (image.header.frame_id != info_.header.frame_id ||
+        depth.header.frame_id != info_.header.frame_id ||
+        image.width != info_.width || image.height != info_.height ||
+        depth.width != info_.width || depth.height != info_.height) {
+      fail("image/depth frame or dimensions changed; restart required");
+      return {};
+    }
+    const auto t = stamp(image.header.stamp);
+    const auto d = stamp(depth.header.stamp);
+    if (lastStamp_ >= 0 && (t <= lastStamp_ || d <= lastDepthStamp_)) {
+      fail("non-increasing image/depth time; restart required");
+      return {};
+    }
+    if (t < firstStamp_ || d < firstStamp_) return {};
+    lastStamp_ = t;
+    lastDepthStamp_ = d;
+    auto out = std::make_shared<Info>(info_);
+    out->header.stamp = image.header.stamp;
+    return out;
+  }
+  std::string fault() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return fault_;
+  }
+private:
+  static int64_t stamp(const builtin_interfaces::msg::Time & t) {
+    return int64_t(t.sec) * 1000000000LL + t.nanosec;
+  }
+  template<class Values> static bool finite(const Values & values) {
+    for (auto v : values) if (!std::isfinite(v)) return false;
+    return true;
+  }
+  static bool valid(const Info & i) {
+    return i.header.stamp.sec >= 0 && i.header.stamp.nanosec < 1000000000 &&
+      !i.header.frame_id.empty() && i.width > 0 && i.height > 0 &&
+      finite(i.d) && finite(i.k) && finite(i.r) && finite(i.p) &&
+      i.k[0] > 0 && i.k[4] > 0 && i.k[8] == 1 &&
+      i.p[0] > 0 && i.p[5] > 0 && i.p[10] == 1;
+  }
+  bool fail(const std::string & reason) { fault_ = reason; return false; }
+  mutable std::mutex mutex_;
+  Info info_, identity_;
+  bool ready_ = false;
+  int64_t firstStamp_ = 0, lastStamp_ = -1, lastDepthStamp_ = -1;
+  std::string fault_;
+};
+}
