+void RGBDOdometry::cachedPairCallback(const sensor_msgs::msg::Image::ConstSharedPtr image,
+		const sensor_msgs::msg::Image::ConstSharedPtr depth)
+{
+	auto info = calibrationCache_.forPair(*image, *depth);
+	if(!info)
+	{
+		timingAudit("cache_reject", rclcpp::Time(image->header.stamp).nanoseconds());
+		RCLCPP_WARN_THROTTLE(this->get_logger(), *this->get_clock(), 5000,
+			"Calibration cache rejected pair (waiting for calibration/eligible time, or fault='%s')",
+			calibrationCache_.fault().c_str());
+		return;
+	}
+	callback(image, depth, info);
+}
