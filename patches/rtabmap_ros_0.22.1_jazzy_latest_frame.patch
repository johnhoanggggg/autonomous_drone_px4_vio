diff --git a/rtabmap_odom/include/rtabmap_odom/TimingAudit.h b/rtabmap_odom/include/rtabmap_odom/TimingAudit.h
new file mode 100644
index 0000000..530d9e5
--- /dev/null
+++ b/rtabmap_odom/include/rtabmap_odom/TimingAudit.h
@@ -0,0 +1,23 @@
+#pragma once
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+
+namespace rtabmap_odom {
+// Isolated diagnostic overlay only. Disabled unless explicitly requested.
+inline void timingAudit(const char *event, int64_t stamp)
+{
+    static const bool enabled = std::getenv("RTABMAP_TIMING_AUDIT") != nullptr;
+    if(!enabled) return;
+    const auto wall = std::chrono::steady_clock::now().time_since_epoch();
+    std::fprintf(stderr, "TIMING_AUDIT %s %lld %lld\n", event,
+        static_cast<long long>(stamp),
+        static_cast<long long>(std::chrono::duration_cast<std::chrono::nanoseconds>(wall).count()));
+}
+struct TimingAuditScope {
+    const char *event;
+    int64_t stamp;
+    ~TimingAuditScope() { timingAudit(event, stamp); }
+};
+}
