+#include "rtabmap_odom/ImmutableCameraInfo.h"
+#include <gtest/gtest.h>
+#include <limits>
+using Cache = rtabmap_odom::ImmutableCameraInfo;
+static Cache::Info info() {
+  Cache::Info i;
+  i.header.frame_id = "optical"; i.header.stamp.sec = 10;
+  i.width = 640; i.height = 400;
+  i.k = {400,0,320,0,400,200,0,0,1};
+  i.r = {1,0,0,0,1,0,0,0,1};
+  i.p = {400,0,320,0,0,400,200,0,0,0,1,0};
+  return i;
+}
+static Cache::Image frame(int sec = 10) {
+  Cache::Image i; i.header = info().header; i.header.stamp.sec = sec;
+  i.width = 640; i.height = 400; return i;
+}
+TEST(Cache, WaitsForCalibration) { Cache c; EXPECT_FALSE(c.forPair(frame(), frame())); }
+TEST(Cache, RestampsWithoutChangingIdentity) {
+  Cache c; ASSERT_TRUE(c.observe(info())); auto i = info(); i.header.stamp.sec = 12;
+  EXPECT_TRUE(c.observe(i)); auto out = c.forPair(frame(11), frame(11)); ASSERT_TRUE(out);
+  EXPECT_EQ(out->header.stamp.sec, 11); EXPECT_EQ(out->k, i.k);
+}
+TEST(Cache, RejectsFutureCalibrationForOldFrames) {
+  Cache c; ASSERT_TRUE(c.observe(info())); EXPECT_FALSE(c.forPair(frame(9), frame(9)));
+  EXPECT_TRUE(c.forPair(frame(), frame()));
+}
+TEST(Cache, LatchesEverySemanticChange) {
+  for(int field = 0; field < 12; ++field) {
+    Cache c; ASSERT_TRUE(c.observe(info())); auto changed = info();
+    switch(field) {
+      case 0: changed.header.frame_id = "other"; break;
+      case 1: ++changed.width; break; case 2: ++changed.height; break;
+      case 3: changed.distortion_model = "plumb_bob"; break;
+      case 4: changed.d.push_back(0.1); break; case 5: changed.k[2] += 1; break;
+      case 6: changed.r[0] += 0.1; break; case 7: changed.p[2] += 1; break;
+      case 8: ++changed.binning_x; break; case 9: ++changed.binning_y; break;
+      case 10: ++changed.roi.x_offset; break; case 11: changed.roi.do_rectify = true; break;
+    }
+    EXPECT_FALSE(c.observe(changed)); EXPECT_FALSE(c.observe(info()));
+    EXPECT_FALSE(c.forPair(frame(), frame())); EXPECT_FALSE(c.fault().empty());
+  }
+}
+TEST(Cache, InvalidCalibrationLatches) {
+  for(int field = 0; field < 5; ++field) {
+    Cache c; auto i = info();
+    if(field == 0) i.k[0] = 0;
+    if(field == 1) i.p[0] = std::numeric_limits<double>::quiet_NaN();
+    if(field == 2) i.width = 0;
+    if(field == 3) i.header.frame_id.clear();
+    if(field == 4) i.d.push_back(std::numeric_limits<double>::infinity());
+    EXPECT_FALSE(c.observe(i)); EXPECT_FALSE(c.observe(info()));
+  }
+}
+TEST(Cache, ImageMismatchLatches) {
+  for(int field = 0; field < 4; ++field) {
+    Cache c; ASSERT_TRUE(c.observe(info())); auto a = frame(), b = frame();
+    if(field == 0) a.header.frame_id = "other";
+    if(field == 1) b.header.frame_id = "other";
+    if(field == 2) a.width = 0;
+    if(field == 3) b.height = 0;
+    EXPECT_FALSE(c.forPair(a,b)); EXPECT_FALSE(c.forPair(frame(),frame()));
+  }
+}
+TEST(Cache, NonIncreasingTimesLatch) {
+  for(int field = 0; field < 3; ++field) {
+    Cache c; ASSERT_TRUE(c.observe(info())); ASSERT_TRUE(c.forPair(frame(11),frame(11)));
+    EXPECT_FALSE(c.forPair(frame(field == 0 ? 9 : field == 1 ? 11 : 12), frame(11)));
+    EXPECT_FALSE(c.forPair(frame(13),frame(13)));
+  }
+}
